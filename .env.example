# Servidor
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://user:pass@host:27017/petconnect

# JWT
JWT_SECRET=changeme
JWT_EXPIRES_IN=7d

# Correo (Nodemailer)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_user
MAIL_PASS=your_pass
MAIL_FROM="PetConnect <no-reply@petconnect.app>"

# IA (proxy desde backend; nunca exponer al frontend)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=7d

MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="PetConnect <no-reply@petconnect.app>"

# Correos de administradores para avisos (nuevo proveedor, etc.). Separar por coma o punto y coma.
ADMIN_NOTIFICATION_EMAILS=admin@ejemplo.com

# Nominatim (OpenStreetMap) — geocodificación de direcciones de proveedores
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_MS=7000
NOMINATIM_USER_AGENT="PetConnectBackend/1.0 (contacto: admin@petconnect.app)"
