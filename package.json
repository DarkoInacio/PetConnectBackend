{
  "name": "petconnect-backend",
  "version": "1.0.0",
  "description": "Backend de PetConnect - API REST con Node.js, Express y MongoDB",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "migrate:clinic-services": "node scripts/migrate-clinic-services.js",
    "seed:admin": "node scripts/create-admin.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed:smoke": "node scripts/seed-smoke.js",
    "seed:qa": "node scripts/seed-qa.js",
    "test:smoke": "newman run postman/PetConnect.postman_collection.json -e postman/PetConnect-CI.postman_environment.json --folder Smoke --reporters cli --color on --timeout-request 10000",
    "test:smoke:full": "node scripts/run-smoke.js",
    "test:qa": "node scripts/run-qa-newman.js",
    "test:qa:full": "node scripts/run-qa.js"
  },
  "keywords": [
    "node",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "api",
    "petconnect"
  ],
  "author": "PetConnect",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongoose": "^8.3.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.3",
    "pdfkit": "^0.18.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "newman": "^6.2.1",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
